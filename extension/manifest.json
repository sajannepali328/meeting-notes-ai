{
  "manifest_version": 3,
  "name": "Activity Observer",
  "version": "1.0",
  "description": "Observes Gmail sends and triggers API calls to backend.",
  "permissions": [],
  "host_permissions": [
    "https://mail.google.com/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content_scripts/gmail.js"]
    }
  ]
}